<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/scaffold_bg">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/scaffold_bg"
            app:navigationIcon="@drawable/ic_menu" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scout_manually"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="260dp"
                        android:layout_height="56dp"
                        android:text="Scout Manually"
                        android:textColor="@color/accent"
                        app:strokeColor="@color/accent"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Drawer -->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/surface">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="MENU"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.15" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <TextView
            android:id="@+id/drawer_item_scout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Scout"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:background="@color/resume_highlight_bg" />

        <TextView
            android:id="@+id/drawer_item_sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Sync Now"
            android:textColor="@color/text" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
